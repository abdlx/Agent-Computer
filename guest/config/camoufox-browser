#!/bin/bash
# 1. Unset proxy env vars so Camoufox never inherits unresolvable proxies
unset HTTP_PROXY HTTPS_PROXY http_proxy https_proxy ACP_BROWSER_PROXY 2>/dev/null || true

# 2. Ensure clean profile directory exists and remove any stale proxy prefs
mkdir -p /home/agent/.camoufox-profile
if [ -f /home/agent/.camoufox-profile/prefs.js ]; then
    sed -i '/network.proxy/d' /home/agent/.camoufox-profile/prefs.js 2>/dev/null || true
    sed -i '/acp-egress/d' /home/agent/.camoufox-profile/prefs.js 2>/dev/null || true
fi

BIN=$(find /opt/browser-runtime/.cache/camoufox/browsers -name "camoufox" -type f -executable 2>/dev/null | head -n 1)
if [ -n "$BIN" ]; then
    exec "$BIN" --profile /home/agent/.camoufox-profile "$@"
elif which chromium >/dev/null 2>&1; then
    exec chromium --user-data-dir=/home/agent/.config/agent-browser-profile "$@"
fi
