#!/bin/bash
BIN=$(find /opt/browser-runtime/.cache/camoufox/browsers -name "camoufox" -type f -executable 2>/dev/null | head -n 1)
if [ -n "$BIN" ]; then
    exec "$BIN" --profile /home/agent/.camoufox-profile "$@"
elif which chromium >/dev/null 2>&1; then
    exec chromium --user-data-dir=/home/agent/.config/agent-browser-profile "$@"
fi
