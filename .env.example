# Copy to .env and fill in. Never commit a real .env.

# REQUIRED: shared secret between the control plane and the Docker
# supervisor. Generate one:  openssl rand -hex 32
ACP_SUPERVISOR_SECRET=

# Guest image the supervisor instantiates (build it with:
#   docker compose --profile build build guest-image)
ACP_GUEST_IMAGE=agentcomputer/guest:phase0

# Seconds of inactivity before a computer auto-sleeps (default 300).
ACP_IDLE_TIMEOUT_S=300

# Refuse to create computers when the host's Docker volumes filesystem
# has less than this many GB free (default 5; 0 disables the guard).
ACP_MIN_FREE_DISK_GB=5

# Capacity probe: docker-compose mounts a dedicated named volume (acp-storage-probe)
# automatically on the Docker storage filesystem. No host directory is required.

# Reserve host RAM; minimum accepted 512 MB. Default keeps 1 GB available.
ACP_HOST_RESERVE_MB=1024
ACP_MAX_RUNNING=4
# CPU commitments / physical CPU capacity; valid range 1..4.
ACP_CPU_OVERCOMMIT=1

# Set the external HTTPS origin behind a reverse proxy (no trailing path).
ACP_PUBLIC_ORIGIN=
# Enable only behind your own trusted proxy; keep the direct port private.
ACP_TRUST_PROXY=false
